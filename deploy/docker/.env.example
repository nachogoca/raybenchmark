# Copy to deploy/docker/.env. All values shown are the defaults.
MODEL_ARCH=deepfm            # deepfm | dcnv2
MODEL_SIZE=small             # small | large
ONNX_DIR=/models/onnx        # files: ${MODEL_ARCH}_${MODEL_SIZE}.onnx
ORT_INTRA_THREADS=1
ORT_INTER_THREADS=1
ORT_PROVIDER=CPUExecutionProvider   # or CUDAExecutionProvider
REPLICAS=1                   # uvicorn workers / Ray replicas / Triton instance_group count
BATCHING=0                   # 0 | 1
BATCH_MAX=64
BATCH_WAIT_MS=5
PORT=8000
TRITON_URL=triton:8001       # ray_triton_grpc only
MODEL_REPO=/models/repo      # Triton model repository (named volume triton_repo)
SERVING_CPUSET=0-5           # cores for the serving stack (k6 uses 6-7)
MEM_LIMIT=8g
